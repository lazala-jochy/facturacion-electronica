{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "predev": "sh -c 'lsof -ti :3001 | xargs kill -9 2>/dev/null || true'",
    "dev": "cross-env DATABASE_URL=\"file:./prisma/dev.db\" ts-node-dev src/index.ts",
    "build": "tsc",
    "start": "cross-env DATABASE_URL=\"file:./prisma/dev.db\" node dist/index.js",
    "migrate:dev": "cross-env DATABASE_URL=\"file:./prisma/dev.db\" prisma migrate dev",
    "migrate:deploy": "cross-env DATABASE_URL=\"file:./prisma/dev.db\" prisma migrate deploy",
    "prisma:generate": "cross-env DATABASE_URL=\"file:./prisma/dev.db\" prisma generate",
    "ecf-excel-batch": "node script/run.js",
    "test:signer": "npm run build && node --test dist/services/dgiiXmlSigner.test.js",
    "test:acecf": "npm run build && node --test dist/commercial-approvals/acecfSheet.test.js dist/commercial-approvals/acecfXmlBuilder.test.js dist/commercial-approvals/acecfDgiiResponse.test.js",
    "test:xml": "npm run build && node --test dist/services/xmlBuilder.regression.test.js",
    "test:ri": "npm run build && node --test dist/utils/ecfRepresentacionImpresaData.test.js dist/utils/ecfConsultaTimbreQr.test.js",
    "test:formatos": "npm run build && node --test dist/utils/dgiiFormato606607.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@xmldom/xmldom": "^0.9.10",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-forge": "^1.4.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "xml-crypto": "^6.1.2",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^7.0.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
