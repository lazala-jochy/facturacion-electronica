datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id                    Int          @id @default(autoincrement())
  name                  String
  rnc                   String       @unique
  address               String
  phone                 String?
  email                 String?
  logoUrl               String?      @map("logo_url")
  regime                   String?      @default("Régimen general")
  certificateSalt          String?      @map("certificate_salt")
  certificateEncPath       String?      @map("certificate_enc_path")
  certificatePasswordEnc   String?      @map("certificate_password_enc")
  // URL servicio DGII e-CF (legacy: recepción directa sin flujo token).
  dgiiEcfEndpoint            String?      @map("dgii_ecf_endpoint")
  dgiiUsername               String?      @map("dgii_username")
  dgiiPassword               String?      @map("dgii_password")
  dgiiAuthUrl                String?      @map("dgii_auth_url")
  dgiiReceptionUrl           String?      @map("dgii_reception_url")
  dgiiConsultUrl             String?      @map("dgii_consult_url")
  // Clave de cifrado del .p12 (texto en BD; misma que usás al guardar el certificado).
  certificateKeyphrase       String?      @map("certificate_keyphrase")
  createdAt                DateTime     @default(now()) @map("created_at")
  users        User[]
  clients      Client[]
  cotizaciones Cotizacion[]

  @@map("companies")
}

model User {
  id                   Int                   @id @default(autoincrement())
  fullName             String                @map("full_name")
  cedula               String                @unique
  email                String                @unique
  password             String
  companyId            Int                   @map("company_id")
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt            DateTime              @default(now()) @map("created_at")
  passwordResetTokens PasswordResetToken[]

  @@index([companyId])
  @@map("users")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model Client {
  id           Int          @id @default(autoincrement())
  name         String
  address      String?
  rncCedula    String       @map("rnc_cedula")
  rnc          String?
  cedula       String?
  phone        String?
  email        String?
  companyId    Int          @map("company_id")
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cotizaciones Cotizacion[]
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([companyId])
  @@index([rnc])
  @@index([cedula])
  @@map("clients")
}

model Cotizacion {
  id             Int              @id @default(autoincrement())
  number         Int
  clientId       Int              @map("client_id")
  companyId      Int              @map("company_id")
  documentTitle  String           @default("Pre-factura") @map("document_title")
  fiscalLegend   String           @default("Sin valor fiscal") @map("fiscal_legend")
  paymentTerms   String           @map("payment_terms")
  paymentMethod  String?          @map("payment_method")
  accountManager String           @map("account_manager")
  comment        String?          @map("comment")
  subtotal       Float
  itbis          Float
  total          Float
  dgiiTrackId    String?          @map("dgii_track_id")
  dgiiStatus     String?          @map("dgii_status")
  dgiiResponse   String?          @map("dgii_response")
  signedXml      String?          @map("signed_xml")
  dgiiSubmittedAt DateTime?       @map("dgii_submitted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items          CotizacionItem[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@map("cotizaciones")
}

model CotizacionItem {
  id           Int        @id @default(autoincrement())
  cotizacionId Int        @map("cotizacion_id")
  itemNumber   Int        @map("item_number")
  quantity     Float
  unit         String
  description  String
  unitPrice    Float      @map("unit_price")
  totalValue   Float      @map("total_value")
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@index([cotizacionId])
  @@map("cotizacion_items")
}
