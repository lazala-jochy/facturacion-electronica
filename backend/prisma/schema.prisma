datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

model Company {
  id                    Int          @id @default(autoincrement())
  name                  String
  rnc                   String       @unique
  address               String
  phone                 String?
  email                 String?
  logoUrl               String?      @map("logo_url")
  regime                   String?      @default("Régimen general")
  certificateSalt          String?      @map("certificate_salt")
  certificateEncPath       String?      @map("certificate_enc_path")
  certificatePasswordEnc   String?      @map("certificate_password_enc")
  // URL servicio DGII e-CF (legacy: recepción directa sin flujo token).
  dgiiEcfEndpoint            String?      @map("dgii_ecf_endpoint")
  dgiiUsername               String?      @map("dgii_username")
  dgiiPassword               String?      @map("dgii_password")
  dgiiAuthUrl                String?      @map("dgii_auth_url")
  dgiiReceptionUrl           String?      @map("dgii_reception_url")
  dgiiConsultUrl             String?      @map("dgii_consult_url")
  dgiiCommercialApprovalUrl  String?      @map("dgii_commercial_approval_url")
  dgiiSeedUrl                String?      @map("dgii_seed_url")
  dgiiValidateSeedUrl        String?      @map("dgii_validate_seed_url")
  dgiiEcfReceiveUrl          String?      @map("dgii_ecf_receive_url")
  dgiiTrackUrl               String?      @map("dgii_track_url")
  dgiiStatusUrl              String?      @map("dgii_status_url")
  dgiiEnvironment            String?      @default("CERTIFICACION") @map("dgii_environment")
  // Paso 4 CerteCF — simulación e-CF (URLs exclusivas; no se mezclan con Paso 2).
  dgiiPaso4AuthUrl             String?      @map("dgii_paso4_auth_url")
  dgiiPaso4ReceptionUrl      String?      @map("dgii_paso4_reception_url")
  dgiiPaso4ConsultUrl        String?      @map("dgii_paso4_consult_url")
  dgiiPaso4RfceUrl           String?      @map("dgii_paso4_rfce_url")
  dgiiPaso4Environment         String?      @default("CERTIFICACION") @map("dgii_paso4_environment")
  dgiiPaso4SeedUrl           String?      @map("dgii_paso4_seed_url")
  dgiiPaso4ValidateSeedUrl   String?      @map("dgii_paso4_validate_seed_url")
  dgiiPaso4EcfReceiveUrl     String?      @map("dgii_paso4_ecf_receive_url")
  // DGII Communication Gateway (ecf-gateway) — conector local, ver ecfGatewayClient.ts.
  ecfGatewayBaseUrl          String?      @map("ecf_gateway_base_url")
  ecfGatewayApiKey           String?      @map("ecf_gateway_api_key")
  certificatePath            String?      @map("certificate_path")
  certificatePassword        String?      @map("certificate_password")
  tokenCache                 String?      @map("token_cache")
  tokenExpiration            DateTime?    @map("token_expiration")
  // Clave de cifrado del .p12 (texto en BD; misma que usás al guardar el certificado).
  certificateKeyphrase       String?      @map("certificate_keyphrase")
  createdAt                DateTime     @default(now()) @map("created_at")
  users        User[]
  clients      Client[]
  cotizaciones Cotizacion[]
  ecfSeqCounters CompanyEcfSeqCounter[]
  compras606     Compra606[]

  @@map("companies")
}

/// Líneas de compras para formato 606 (gastos / proveedores).
model Compra606 {
  id                  Int      @id @default(autoincrement())
  companyId           Int      @map("company_id")
  periodo             String
  rncCedula           String   @map("rnc_cedula")
  tipoBienesServicios String   @default("02") @map("tipo_bienes_servicios")
  ncf                 String
  ncfModificado       String?  @map("ncf_modificado")
  fechaComprobante    String   @map("fecha_comprobante")
  fechaPago           String?  @map("fecha_pago")
  montoServicios      Float    @default(0) @map("monto_servicios")
  montoBienes         Float    @default(0) @map("monto_bienes")
  montoFacturado      Float    @map("monto_facturado")
  itbisFacturado              Float    @default(0) @map("itbis_facturado")
  itbisRetenido               Float    @default(0) @map("itbis_retenido")
  itbisSujetoProporcionalidad Float    @default(0) @map("itbis_sujeto_proporcionalidad")
  itbisLlevadoAlCosto         Float    @default(0) @map("itbis_llevado_al_costo")
  itbisPorAdelantar           Float    @default(0) @map("itbis_por_adelantar")
  itbisPercibidoCompras       Float    @default(0) @map("itbis_percibido_compras")
  retencionRenta              Float    @default(0) @map("retencion_renta")
  tipoRetencionIsr            String?  @map("tipo_retencion_isr")
  isrPercibidoCompras         Float    @default(0) @map("isr_percibido_compras")
  impuestoIsc                 Float    @default(0) @map("impuesto_isc")
  impuestosOtros              Float    @default(0) @map("impuestos_otros")
  montoPropinaLegal           Float    @default(0) @map("monto_propina_legal")
  formaPago                   String   @default("04") @map("forma_pago")
  createdAt           DateTime @default(now()) @map("created_at")
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, periodo])
  @@map("compras_606")
}

/// Última secuencia e-NCF consumida por empresa y tipo (cola DGII: siguiente = lastSeq + 1).
model CompanyEcfSeqCounter {
  id        Int     @id @default(autoincrement())
  companyId Int     @map("company_id")
  ecfTipo   String  @map("ecf_tipo")
  lastSeq   Int     @default(0) @map("last_seq")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, ecfTipo], name: "company_ecf_tipo_seq")
  @@index([companyId])
  @@map("company_ecf_seq_counters")
}

model User {
  id                   Int                   @id @default(autoincrement())
  fullName             String                @map("full_name")
  cedula               String                @unique
  email                String                @unique
  password             String
  companyId            Int                   @map("company_id")
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt            DateTime              @default(now()) @map("created_at")
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model Client {
  id           Int          @id @default(autoincrement())
  name         String
  address      String?
  rncCedula    String       @map("rnc_cedula")
  rnc          String?
  cedula       String?
  phone        String?
  email        String?
  companyId    Int          @map("company_id")
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cotizaciones Cotizacion[]
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([companyId])
  @@index([rnc])
  @@index([cedula])
  @@map("clients")
}

model Cotizacion {
  id             Int              @id @default(autoincrement())
  number         Int
  clientId       Int              @map("client_id")
  companyId      Int              @map("company_id")
  documentTitle  String           @default("Pre-factura") @map("document_title")
  fiscalLegend   String           @default("Sin valor fiscal") @map("fiscal_legend")
  paymentTerms   String           @map("payment_terms")
  paymentMethod  String?          @map("payment_method")
  accountManager String           @map("account_manager")
  comment        String?          @map("comment")
  subtotal       Float
  itbis          Float
  total          Float
  /// Exenta de ITBIS: fuerza itbis=0 y usa el bloque de totales exentos en el e-CF.
  exento         Boolean          @default(false) @map("exento")
  dgiiTrackId    String?          @map("dgii_track_id")
  dgiiStatus     String?          @map("dgii_status")
  dgiiResponse   String?          @map("dgii_response")
  signedXml      String?          @map("signed_xml")
  dgiiSubmittedAt DateTime?       @map("dgii_submitted_at")
  /// Reintentos automáticos cuando DGII no responde tras firmar.
  dgiiSubmitRetryCount   Int       @default(0) @map("dgii_submit_retry_count")
  dgiiSubmitNextRetryAt  DateTime? @map("dgii_submit_next_retry_at")
  dgiiSubmitLastError    String?   @map("dgii_submit_last_error")
  dgiiSubmitCertProfile  String?   @map("dgii_submit_cert_profile")
  /// Marca cuando este e-CF se incluyo en un TXT 607 generado — evita reportarlo dos veces.
  formato607GeneradoAt   DateTime? @map("formato_607_generado_at")
  /// Código tipo e-NCF (ej. 31 factura crédito fiscal, 32 consumo).
  ecfTipo        String           @default("31") @map("ecf_tipo")
  /// Correlativo e-NCF por empresa y tipo (cola numérica del e-CF).
  ecfNcfSeq      Int              @map("ecf_ncf_seq")
  /// e-NCF / NCF del comprobante asociado (notas débito/crédito, etc.).
  ecfReferenceNcf String?         @map("ecf_reference_ncf")
  /// Representación impresa (PDF) conservada tras envío e-CF; ruta relativa a uploads.
  ecfRiPdfPath    String?         @map("ecf_ri_pdf_path")
  /// URL exacta incrustada en el QR (consulta timbre DGII).
  ecfRiQrUrl      String?         @map("ecf_ri_qr_url")
  ecfRiGeneratedAt DateTime?      @map("ecf_ri_generated_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items          CotizacionItem[]

  @@unique([companyId, number])
  @@unique([companyId, ecfTipo, ecfNcfSeq], name: "cotizacion_company_tipo_encf_seq")
  @@index([companyId])
  @@index([clientId])
  @@map("cotizaciones")
}

model CotizacionItem {
  id           Int        @id @default(autoincrement())
  cotizacionId Int        @map("cotizacion_id")
  itemNumber   Int        @map("item_number")
  quantity     Float
  unit         String
  description  String
  unitPrice    Float      @map("unit_price")
  totalValue   Float      @map("total_value")
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@index([cotizacionId])
  @@map("cotizacion_items")
}
