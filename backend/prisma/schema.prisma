datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id               Int      @id @default(autoincrement())
  rnc              String
  razonSocial      String
  email            String
  password         String
  direccion        String
  createdAt        DateTime @default(now())
}

