datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id           Int          @id @default(autoincrement())
  name         String
  rnc          String       @unique
  address      String
  phone        String?
  email        String?
  regime       String?      @default("Régimen general")
  createdAt    DateTime     @default(now()) @map("created_at")
  users        User[]
  clients      Client[]
  cotizaciones Cotizacion[]

  @@map("companies")
}

model User {
  id        Int      @id @default(autoincrement())
  fullName  String   @map("full_name")
  cedula    String   @unique
  email     String   @unique
  password  String
  companyId Int      @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("users")
}

model Client {
  id           Int          @id @default(autoincrement())
  name         String
  rncCedula    String       @map("rnc_cedula")
  rnc          String?
  cedula       String?
  phone        String?
  email        String?
  companyId    Int          @map("company_id")
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cotizaciones Cotizacion[]
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([companyId])
  @@index([rnc])
  @@index([cedula])
  @@map("clients")
}

model Cotizacion {
  id             Int              @id @default(autoincrement())
  number         Int
  clientId       Int              @map("client_id")
  companyId      Int              @map("company_id")
  documentTitle  String           @default("Pre-factura") @map("document_title")
  fiscalLegend   String           @default("Sin valor fiscal") @map("fiscal_legend")
  paymentTerms   String           @map("payment_terms")
  accountManager String           @map("account_manager")
  subtotal       Float
  itbis          Float
  total          Float
  createdAt      DateTime         @default(now()) @map("created_at")
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items          CotizacionItem[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@map("cotizaciones")
}

model CotizacionItem {
  id           Int        @id @default(autoincrement())
  cotizacionId Int        @map("cotizacion_id")
  itemNumber   Int        @map("item_number")
  quantity     Float
  unit         String
  description  String
  unitPrice    Float      @map("unit_price")
  totalValue   Float      @map("total_value")
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@index([cotizacionId])
  @@map("cotizacion_items")
}
