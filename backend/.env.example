DATABASE_URL="file:./prisma/dev.db"

# DGII Communication Gateway (opcional): si no se configura, el connector de polling no arranca.
# ECF_GATEWAY_BASE_URL="https://<slug>.gateway.tudominio.com"
# ECF_GATEWAY_API_KEY="<connectorId>.<secret>"   -- se obtiene del panel admin del gateway
# ECF_GATEWAY_CONNECTOR=false                    -- desactiva el connector aunque haya URL/API key
# ECF_GATEWAY_CONNECTOR_WORKERS=2                -- loops de long-polling concurrentes
