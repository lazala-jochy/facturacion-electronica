# Variables de entorno en runtime para `facturacion-electronica:web` (ver Dockerfile).
# Copiar a .env.docker y completar antes de `docker run --env-file .env.docker ...`.
# No confundir con backend/.env ni frontend/.env (esos son para dev local / Electron).
#
# SIN COMILLAS: a diferencia de dotenv (que usa backend/.env), `docker run --env-file` no
# interpreta comillas -- `DATABASE_URL="postgresql://..."` le llegaría a Prisma con las
# comillas incluidas y fallaría la validación de la URL. Todos los valores van pelados.

# --- Base de datos (Postgres en Supabase -- el mismo proyecto que usa la build de escritorio) ---
DATABASE_URL=postgresql://...
DIRECT_URL=postgresql://...

# --- Secretos de la app (obligatorios) ---
# Cifra certificado .p12 / contraseña de cada empresa en la base. Perderla = no se puede
# desencriptar lo ya guardado.
APP_SECRETS_KEY=<32+ bytes aleatorios>
# Firma los JWT de sesión.
JWT_SECRET=<secreto largo y aleatorio>

# --- JWT (opcionales, tienen default en código) ---
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_EXPIRES_IN=7d
# REFRESH_TOKEN_DAYS=30

# --- Supabase Edge Functions (register/login/forgot-password/reset-password) ---
# Mismos valores públicos horneados por default en companyLogo.ts / auth -- solo
# hace falta setearlos si cambia el proyecto de Supabase.
# SUPABASE_FUNCTIONS_URL=https://<project-ref>.supabase.co/functions/v1
# SUPABASE_ANON_KEY=<anon key>

# --- DGII Communication Gateway (opcional; sin esto el Local Connector no arranca) ---
# ECF_GATEWAY_BASE_URL=https://<slug>.gateway.tudominio.com
# ECF_GATEWAY_API_KEY=<connectorId>.<secret>
# ECF_GATEWAY_CONNECTOR=false
# ECF_GATEWAY_CONNECTOR_WORKERS=2

# --- DGII e-CF directo (legacy / pruebas, opcional) ---
# DGII_ECF_ENDPOINT=
# DGII_ECF_TOKEN=
# DGII_BEARER_TOKEN=
# DGII_TOKEN=
# DGII_AUTH_BODY_MODE=
# DGII_ALLOW_DIRECT_ECF32_UNDER_250K=
# DGII_ENCF_FECHA_VENC_SECUENCIA=
# DGII_EMISOR_PROVINCIA_DEFAULT=
# DGII_EMISOR_MUNICIPIO_DEFAULT=
# DGII_COMPRADOR_PROVINCIA_DEFAULT=
# DGII_COMPRADOR_MUNICIPIO_DEFAULT=

# --- Worker de reintento de envíos a DGII (opcional) ---
# DGII_SUBMIT_RETRY_WORKER=true
# DGII_SUBMIT_MAX_RETRIES=
# DGII_SUBMIT_RETRY_BATCH_SIZE=
# DGII_SUBMIT_RETRY_INTERVAL_MS=

# --- Infra del contenedor (ya tienen default en el Dockerfile, normalmente no hace falta tocar) ---
# PORT=3001
# UPLOADS_DIR=/data/uploads
# ECF_TEST_ASSETS_DIR=
