{
  "name": "facturacion-electronica-rd",
  "version": "1.1.19",
  "main": "dist/main.js",
  "scripts": {
    "compile": "tsc",
    "start": "npm run compile && electron .",
    "build:modules": "npm --prefix ../frontend run build && npm --prefix ../backend exec tsc -- --noEmit && npm run compile",
    "build:all": "npm --prefix ../frontend run build && npm --prefix ../backend run build && npm run compile",
    "build": "npm run build:all && dotenv -e .env -- electron-builder --publish never",
    "release": "sh scripts/release-all.sh always",
    "release:dry": "sh scripts/release-all.sh never",
    "dist:win": "npm run build:all && electron-builder --win nsis",
    "dist:dir": "npm run build:all && electron-builder --dir"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.1",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^10.0.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.0.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.facturacionelectronica.rd",
    "productName": "Lazala Facturacion",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "lazala-jochy",
        "repo": "facturacion-electronica"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "backend-runtime/node_modules/.prisma/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend-dist"
      },
      {
        "from": "../backend/dist",
        "to": "backend-runtime/dist"
      },
      {
        "from": "../backend/package.json",
        "to": "backend-runtime/package.json"
      },
      {
        "from": "../backend/package-lock.json",
        "to": "backend-runtime/package-lock.json"
      },
      {
        "from": "../backend/prisma",
        "to": "backend-runtime/prisma"
      },
      {
        "from": "../backend/utils",
        "to": "backend-runtime/utils"
      },
      {
        "from": "../backend/assets",
        "to": "ecf-test-assets"
      }
    ],
    "win": {
      "icon": "assets/default.png",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "../backend/node_modules",
          "to": "backend-runtime/node_modules",
          "filter": [
            "**/*",
            "!typescript/**",
            "!ts-node-dev/**",
            "!@types/**",
            "!.bin/tsc",
            "!.bin/tsserver",
            "!.bin/ts-node-dev",
            "!.bin/tsnd",
            "!.prisma/client/libquery_engine-darwin*"
          ]
        },
        {
          "from": "../backend/dotnet/DgiiXmlSigner/publish/win-x64/DgiiXmlSigner.exe",
          "to": "backend-runtime/dotnet-signer/DgiiXmlSigner.exe"
        }
      ]
    },
    "mac": {
      "icon": "assets/default.png",
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "../backend/node_modules",
          "to": "backend-runtime/node_modules",
          "filter": [
            "**/*",
            "!typescript/**",
            "!ts-node-dev/**",
            "!@types/**",
            "!.bin/tsc",
            "!.bin/tsserver",
            "!.bin/ts-node-dev",
            "!.bin/tsnd",
            "!.prisma/client/query_engine-windows*"
          ]
        },
        {
          "from": "../backend/dotnet/DgiiXmlSigner/publish/osx-x64/DgiiXmlSigner",
          "to": "backend-runtime/dotnet-signer/DgiiXmlSigner"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
